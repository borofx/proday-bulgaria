<div
  class="metafield-display-section page-width"
  style="margin: 20px auto; padding: 15px; border: 1px solid #ddd; border-radius: 6px;"
>
  {% assign key = section.settings.metafield_key %}
  {% assign mf_value = product.metafields.custom[key].value %}

  {% if mf_value != blank %}
    <p>
      Дата:
      {% if section.settings.is_date %}
        {{ mf_value | date: '%d.%m.%Y' }}
      {% else %}
        {{ mf_value }}
      {% endif %}
    </p>
  {% else %}
    <p style="color: #888; font-style: italic;">Няма намерена стойност за поле "{{ key }}" за този продукт.</p>
  {% endif %}
  {{ section.settings.dynamic_date | date: '%d.%m.%Y' | default: 'hey'}}
</div>

{% schema %}
{
  "name": "Metafield display",
  "enabled_on": {
    "templates": ["product", "collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие",
      "default": "Информация за продукта"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Датичка",
      "default": "prodDate",
      "info": "Например: prodDate"
    },
    {
      "type": "checkbox",
      "id": "is_date",
      "label": "Преорматирай като (ДД.ММ.ГГГГ)",
      "default": true
    },
    {
      "type": "text",
      "id": "dynamic_date",
      "label": "Dynamically sourced date"
    }
  ],

  "presets": [
    {
      "name": "Metafield display"
    }
  ]
}
{% endschema %}
