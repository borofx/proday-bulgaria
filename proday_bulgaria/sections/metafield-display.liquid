{{ 'metafield-display.css' | asset_url | stylesheet_tag }}

<div
  class="metafield-display-section page-width"
>
  {% assign key = section.settings.metafield_key %}
  {% assign mf_value = product.metafields.custom[key].value %}

  {% if mf_value != blank %}
    <p>
      Дата:
      {% if section.settings.is_date %}
        {{ mf_value | date: '%d.%m.%Y' }}
      {% else %}
        {{ mf_value }}
      {% endif %}
    </p>
  {% else %}
    <p class="metafield-display-empty">Няма намерена стойност за поле "{{ key }}" за този продукт.</p>
  {% endif %}
  {{ section.settings.dynamic_date | date: '%d.%m.%Y' | default: 'hey' }}
  {% for block in section.blocks %}
    {% if block.type == 'title_block' %}
      <h3>{{ block.settings.heading }}</h3>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Metafield display",
  "enabled_on": {
    "templates": ["product", "collection"]
  },
  "blocks": [
    {
      "type": "text",
      "name": "title_block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Заглавие",
          "default": "Информация за продукта"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Заглавие",
      "default": "Информация за продукта"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Датичка",
      "default": "prodDate",
      "info": "Например: prodDate"
    },
    {
      "type": "checkbox",
      "id": "is_date",
      "label": "Преорматирай като (ДД.ММ.ГГГГ)",
      "default": true
    },
    {
      "type": "text",
      "id": "dynamic_date",
      "label": "Dynamically sourced date"
    }
  ],

  "presets": [
    {
      "name": "Metafield display"
    }
  ]
}
{% endschema %}
